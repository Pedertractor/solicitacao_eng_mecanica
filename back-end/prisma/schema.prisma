generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Unit {
  PEDERTRACTOR
  TRACTOR
}

enum UserRole {
  SUPER_ADMIN
  ADMIN_ENG
  ADMIN_PROCESSOS
  USER
}

enum UserDepartment {
  ENG_MECANICA
  DESENVOLVIMENTO_PROCESSOS
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SolicitationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  COMPLETED
  CANCELLED
  DELETED
}

enum SolicitationDeletionSource {
  SOLICITATION_APP
  KAIRO
}

enum SolicitationClient {
  CATERPILLAR
  CATERPILLAR_GERADORES
  CNH_CONTAGEM
  CNH_CURITIBA
  CNH_PIRACICABA
  CNH_SOROCABA
  CRUCIANELLI
  DYNAPAC
  HYUNDAI
  IVECO
  JACTO
  JCB
  JOHN_DEERE_CATALAO
  JOHN_DEERE_HORIZONTINA
  JOHN_DEERE_INDAIATUBA
  MOTOCANA
  PEDERTRACTOR
  PRAMAC
  SILTOMAC
  TRACTOR_COMPONENTS
  TRIVELATO
  VOLVO
}

enum SolicitationActivityType {
  ANALISE_TECNICA
  DESENHO_2D
  DISP_ELEVACAO
  INSPECAO_CADASTRO
  LEVANTAMENTO_DE_CUSTO
  NR12
  NR13
  NAO_CLASSIFICADA
  PROJETO_INDUSTRIAL
  PROJETO_MELHORIA
  REUNIAO
  VALIDACAO_ESTRUTURAL
}

enum SolicitationProductType {
  AMOSTRA
  PRODUCAO
  PROTOTIPO
  SEM_CLASSIFICACAO
}

enum SolicitationPriority {
  BAIXA
  NORMAL
  SEM_CLASSIFICACAO
  URGENTE
}

enum SolicitationKind {
  PROJETO
  ATIVIDADE
}

model User {
  id           String @id @default(uuid())
  employeeId   String @unique
  name         String
  unit         Unit
  cardNumber   String
  passwordHash String

  role             UserRole           @default(USER)
  department       UserDepartment     @default(ENG_MECANICA)
  approvalStatus   UserApprovalStatus @default(APPROVED)
  active           Boolean            @default(true)

  mustChangePassword Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusUpdates Solicitation[] @relation("SolicitationStatusUpdater")
  kairoSyncs    Solicitation[] @relation("SolicitationKairoSyncer")
  deletions     Solicitation[] @relation("SolicitationDeletedBy")
  kairoCredential UserKairoCredential?

  @@unique([cardNumber, unit])
  @@index([role])
  @@index([unit])
  @@index([department])
}

model UserKairoCredential {
  id               String   @id @default(uuid())
  userId           String   @unique
  apiKeyEncrypted  String
  keyPrefix        String
  linkedAt         DateTime @default(now())
  lastValidatedAt  DateTime?
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Solicitation {
  id String @id @default(uuid())

  trackingCode String @unique

  employeeId     String
  requesterName  String
  requesterEmail String?
  cardNumber     String
  unit           Unit

  costCenter String
  sectorId   String
  sectorName String

  pillarOrLocation String
  title            String
  description      String

  processInstructionRequester     String?
  processInstructionProcess       String?
  processInstructionType          String?
  processInstructionDeadlineLabel String?
  processInstructionDeadlineDate  String?
  deliveryDate                    DateTime?
  partNumbers                     String?
  fileLink                        String?

  department   UserDepartment     @default(ENG_MECANICA)

  kind         SolicitationKind?
  client       SolicitationClient?
  activityType SolicitationActivityType?
  productType  SolicitationProductType?
  priority     SolicitationPriority?

  status                SolicitationStatus @default(PENDING)
  statusUpdatedAt       DateTime?
  statusUpdatedByUserId String?

  kairoCardId          String?
  kairoCardIds         String?
  kairoTeamId          String?
  kairoSyncedAt        DateTime?
  kairoSyncedByUserId  String?

  deletedAt       DateTime?
  deletedByUserId String?
  deletedByName   String?
  deletedFrom     SolicitationDeletionSource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusUpdatedBy User? @relation("SolicitationStatusUpdater", fields: [statusUpdatedByUserId], references: [id])
  kairoSyncedBy   User? @relation("SolicitationKairoSyncer", fields: [kairoSyncedByUserId], references: [id])
  deletedBy       User? @relation("SolicitationDeletedBy", fields: [deletedByUserId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([cardNumber, unit])
  @@index([costCenter])
  @@index([deletedAt])
  @@index([department])
}
